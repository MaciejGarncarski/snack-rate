# THIS IS A DRAFT WORKFLOW, NOT TO BE USED
name: Staging Deploy E2E

on:
  push:
    branches:
      - development

concurrency:
  group: staging-deploy
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Deploy to staging VPS
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.STAGING_VPS_HOST }}
          username: ${{ secrets.STAGING_VPS_USER }}
          key: ${{ secrets.STAGING_VPS_SSH_KEY }}
          script: |
            set -euo pipefail
            cd ${{ secrets.STAGING_VPS_DIR }}

            echo "→ Fetching latest refs..."
            git fetch --all --tags --force --prune

            echo "→ Checking out pushed commit ${{ github.sha }}..."
            git checkout --force --detach "${{ github.sha }}"

            echo "→ Running migrations..."
            docker compose -f compose.yml \
              -f compose.staging.yml \
              --env-file .env.staging \
              run --rm app npm run migrate

            echo "→ Deploying staging stack..."
            docker compose -f compose.yml \
              -f compose.staging.yml \
              --env-file .env.staging \
              up -d --build --remove-orphans

            echo "→ Cleaning old images..."
            docker image prune -af --filter "until=72h"

            echo "✓ ${{ github.sha }} deployed to staging"

  e2e:
    needs: deploy
    runs-on: ubuntu-latest

    env:
      STAGING_APP_URL: https://${{ secrets.STAGING_APP_DOMAIN }}
      STAGING_BASIC_AUTH_USER: ${{ secrets.STAGING_BASIC_AUTH_USER }}
      STAGING_BASIC_AUTH_PASSWORD: ${{ secrets.STAGING_BASIC_AUTH_PASSWORD }}

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      # --- PNPM SETUP ---
      - name: Setup pnpm
        uses: pnpm/action-setup@v6
        with:
          version: 11

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: "pnpm"

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      # --- PLAYWRIGHT ---
      - name: Install Playwright browsers
        run: pnpm exec playwright install --with-deps

      # --- STAGING READINESS ---
      - name: Wait for staging readiness
        run: |
          timeout 120 bash -c '
            until curl -fsS \
              -u "${STAGING_BASIC_AUTH_USER}:${STAGING_BASIC_AUTH_PASSWORD}" \
              "${STAGING_APP_URL}/health/ready"
            do
              echo "Waiting for app..."
              sleep 5
            done
          '

      - name: Verify deployed version
        run: |
          curl -fsS \
            -u "${STAGING_BASIC_AUTH_USER}:${STAGING_BASIC_AUTH_PASSWORD}" \
            "${STAGING_APP_URL}/version" | grep "${{ github.sha }}"

      # --- SMOKE E2E (PLAYWRIGHT) ---
      - name: Run Playwright smoke tests
        env:
          BASE_URL: ${{ env.STAGING_APP_URL }}
          BASIC_AUTH_USER: ${{ env.STAGING_BASIC_AUTH_USER }}
          BASIC_AUTH_PASSWORD: ${{ env.STAGING_BASIC_AUTH_PASSWORD }}
        run: pnpm exec playwright test --grep @smoke

      # --- FALLBACK CURL CHECKS ---
      - name: Verify staging robots.txt
        run: |
          curl --fail --show-error --silent --retry 10 --retry-delay 3 --retry-all-errors \
            "${STAGING_APP_URL}/robots.txt" | grep -q "Disallow: /"

      - name: Verify staging Grafana health
        run: |
          curl --fail --show-error --silent --retry 10 --retry-delay 3 --retry-all-errors \
            -u "${STAGING_BASIC_AUTH_USER}:${STAGING_BASIC_AUTH_PASSWORD}" \
            "${STAGING_APP_URL}/grafana/api/health" > /dev/null
