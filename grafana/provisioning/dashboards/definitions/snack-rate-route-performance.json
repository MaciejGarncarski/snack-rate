{
    "uid": "snack-rate-route-performance",
    "title": "Request Performance by Route",
    "tags": [
        "snack-rate",
        "routes",
        "performance"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "type": "timeseries",
            "title": "Requests/sec by Route",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (http_route, http_method) (rate(http_request_duration_ms_count[5m]))",
                    "legendFormat": "{{http_method}} {{http_route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 10
            }
        },
        {
            "type": "timeseries",
            "title": "p95 Latency by Route (ms)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_request_duration_ms_bucket[5m])))",
                    "legendFormat": "{{http_route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 10
            }
        }
    ]
}