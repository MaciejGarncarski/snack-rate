{
    "uid": "snack-rate-node-resources",
    "title": "Node Resources",
    "tags": [
        "snack-rate",
        "node-exporter",
        "resources"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "job",
                "type": "query",
                "label": "Job",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": "label_values(up, job)",
                "includeAll": false,
                "multi": false,
                "current": {
                    "selected": true,
                    "text": "node-exporter",
                    "value": "node-exporter"
                }
            },
            {
                "name": "host",
                "type": "query",
                "label": "Host",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": "label_values(node_uname_info{job=\"$job\"}, instance)",
                "includeAll": false,
                "multi": false,
                "refresh": 1
            }
        ]
    },
    "panels": [
        {
            "type": "row",
            "title": "Quick CPU / Mem / Disk",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "gauge",
            "title": "CPU Busy",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"$job\", instance=\"$host\", mode=\"idle\"}[5m])) * 100)",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 70
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "gridPos": {
                "x": 0,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "gauge",
            "title": "Sys Load (1m)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "node_load1{job=\"$job\", instance=\"$host\"}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "decimals": 2,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 2
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "gridPos": {
                "x": 3,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "gauge",
            "title": "RAM Used",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"$job\", instance=\"$host\"} / node_memory_MemTotal_bytes{job=\"$job\", instance=\"$host\"})) * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 75
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "gridPos": {
                "x": 6,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "gauge",
            "title": "SWAP Used",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "(1 - (node_memory_SwapFree_bytes{job=\"$job\", instance=\"$host\"} / node_memory_SwapTotal_bytes{job=\"$job\", instance=\"$host\"})) * 100",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "gridPos": {
                "x": 9,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "gauge",
            "title": "Root FS Used",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"$job\", instance=\"$host\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|9p\"} / node_filesystem_size_bytes{job=\"$job\", instance=\"$host\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|9p\"}))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 80
                            },
                            {
                                "color": "red",
                                "value": 90
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "showThresholdLabels": false,
                "showThresholdMarkers": true
            },
            "gridPos": {
                "x": 12,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "stat",
            "title": "CPU Cores",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "count(count(node_cpu_seconds_total{job=\"$job\", instance=\"$host\"}) by (cpu))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto"
            },
            "gridPos": {
                "x": 15,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "stat",
            "title": "Uptime",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "node_time_seconds{job=\"$job\", instance=\"$host\"} - node_boot_time_seconds{job=\"$job\", instance=\"$host\"}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto"
            },
            "gridPos": {
                "x": 18,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "stat",
            "title": "RAM Total",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "node_memory_MemTotal_bytes{job=\"$job\", instance=\"$host\"}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes",
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto"
            },
            "gridPos": {
                "x": 21,
                "y": 1,
                "w": 3,
                "h": 5
            }
        },
        {
            "type": "row",
            "title": "Basic CPU / Mem",
            "gridPos": {
                "x": 0,
                "y": 6,
                "w": 24,
                "h": 1
            },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "timeseries",
            "title": "CPU Basic",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "avg by (mode) (rate(node_cpu_seconds_total{job=\"$job\", instance=\"$host\", mode!~\"idle|guest.*\"}[5m])) * 100",
                    "legendFormat": "{{mode}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                }
            },
            "gridPos": {
                "x": 0,
                "y": 7,
                "w": 12,
                "h": 10
            }
        },
        {
            "type": "timeseries",
            "title": "Memory Basic",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "node_memory_MemTotal_bytes{job=\"$job\", instance=\"$host\"} - node_memory_MemAvailable_bytes{job=\"$job\", instance=\"$host\"}",
                    "legendFormat": "RAM Used",
                    "refId": "A"
                },
                {
                    "expr": "node_memory_MemTotal_bytes{job=\"$job\", instance=\"$host\"}",
                    "legendFormat": "RAM Total",
                    "refId": "B"
                },
                {
                    "expr": "node_memory_SwapTotal_bytes{job=\"$job\", instance=\"$host\"} - node_memory_SwapFree_bytes{job=\"$job\", instance=\"$host\"}",
                    "legendFormat": "SWAP Used",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom"
                }
            },
            "gridPos": {
                "x": 12,
                "y": 7,
                "w": 12,
                "h": 10
            }
        }
    ]
}