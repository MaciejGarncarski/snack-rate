{
    "uid": "snack-rate-app-health",
    "title": "App Health",
    "tags": [
        "snack-rate",
        "app-health"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "templating": {
        "list": []
    },
    "panels": [
        {
            "type": "timeseries",
            "title": "Request rate (req/s)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total[5m]))",
                    "legendFormat": "requests",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            }
        },
        {
            "type": "timeseries",
            "title": "Latency p95 (ms)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le))",
                    "legendFormat": "p95",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            }
        },
        {
            "type": "timeseries",
            "title": "HTTP 5xx rate (req/s)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_status_codes_total{http_status_code=~\"5..\"}[5m]))",
                    "legendFormat": "5xx",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            }
        },
        {
            "type": "table",
            "title": "Recent traces (table)",
            "datasource": {
                "type": "tempo",
                "uid": "tempo"
            },
            "targets": [
                {
                    "queryType": "traceql",
                    "query": "{ resource.service.name = \"tanstack-start-app\" } with (most_recent=true)",
                    "limit": 20,
                    "refId": "A"
                }
            ],
            "options": {
                "showHeader": true
            },
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            }
        },
        {
            "type": "logs",
            "title": "Application logs",
            "datasource": {
                "type": "loki",
                "uid": "loki"
            },
            "targets": [
                {
                    "expr": "{compose_service=\"app\"}",
                    "refId": "A"
                }
            ],
            "options": {
                "showTime": true,
                "showLabels": false,
                "wrapLogMessage": true
            },
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 24,
                "h": 10
            }
        },
        {
            "type": "timeseries",
            "title": "Root filesystem usage (%)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"node-exporter\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node-exporter\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\"}))",
                    "legendFormat": "{{instance}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "gridPos": {
                "x": 0,
                "y": 26,
                "w": 24,
                "h": 8
            }
        },
        {
            "type": "row",
            "title": "Reliability Signals",
            "gridPos": {
                "x": 0,
                "y": 34,
                "w": 24,
                "h": 1
            },
            "collapsed": false,
            "panels": []
        },
        {
            "type": "stat",
            "title": "Readiness failures",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(increase(readiness_failures_total[1h]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto"
            },
            "gridPos": {
                "x": 0,
                "y": 35,
                "w": 12,
                "h": 5
            }
        },
        {
            "type": "stat",
            "title": "DB failures",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum(increase(db_failures_total[1h]))",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "decimals": 0
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "values": false,
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": ""
                },
                "orientation": "auto",
                "textMode": "auto",
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto"
            },
            "gridPos": {
                "x": 12,
                "y": 35,
                "w": 12,
                "h": 5
            }
        }
    ]
}