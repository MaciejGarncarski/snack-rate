APP_PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=db_user
POSTGRES_PASSWORD=ChangeThisPassword
POSTGRES_DB=app_db
DATABASE_URL="postgresql://db_user:ChangeThisPassword@localhost:5432/app_db"

# Grafana
GF_DOMAIN=app.localhost
GF_SERVER_ROOT_URL=http://app.localhost/grafana/
GF_INITIAL_ADMIN_USER=admin
GF_INITIAL_ADMIN_PASSWORD="ChangeGrafanaPassword"
GF_SMTP="smtp.gmail.com:587"
GF_SMTP_USER="your_email@gmail.com"
GF_SMTP_PASSWORD="your_app_password"
GF_SMTP_FROM_ADDRESS="your_email@gmail.com"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OBSERVABILITY_LOG_LEVEL=debug
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_TRACING_ENABLED=true

# Garage
GARAGE_RPC_SECRET="openssl rand -hex 32"
GARAGE_ADMIN_TOKEN="openssl rand -hex 32"
GARAGE_METRICS_TOKEN="openssl rand -hex 32"

# S3 / Storage
S3_ACCESS_KEY="snack-rate-app"
S3_ENDPOINT="http://s3.localhost"
S3_ENDPOINT_INTERNAL="http://garage:3900"
S3_REGION=garage
S3_SECRET_KEY="openssl rand -hex 32"
S3_BUCKET_PUBLIC=snack-rate-public

# Caddy - shared for prod and staging
CADDY_HOST_HTTP_PORT=80
CADDY_HOST_HTTPS_PORT=443
# host-side exposed ports (container always listens on 80/443)
PUBLIC_BUCKET_DOMAIN=s3.localhost
PUBLIC_BUCKET_BACKEND=garage:3902
PUBLIC_BUCKET_HOST=snack-rate-public.localhost

# Caddy — prod
APP_DOMAIN=app.localhost

# Caddy — staging
STAGING_APP_DOMAIN=staging.app.localhost
STAGING_BASIC_AUTH_USER=staging
STAGING_BASIC_AUTH_HASH=
