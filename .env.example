PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=db_user
POSTGRES_PASSWORD=ChangeThisPassword
POSTGRES_DB=app_db
DATABASE_URL="postgresql://db_user:ChangeThisPassword@localhost:5432/app_db"

# Grafana
GRAFANA_DOMAIN=app.localhost
GRAFANA_SERVER_ROOT_URL=http://app.localhost/grafana/
GRAFANA_INITIAL_ADMIN_USER=admin
GRAFANA_INITIAL_ADMIN_PASSWORD="ChangeGrafanaPassword"
GRAFANA_SMTP="smtp.gmail.com:587"
GRAFANA_SMTP_USER="your_email@gmail.com"
GRAFANA_SMTP_PASSWORD="your_app_password"
GRAFANA_SMTP_FROM_ADDRESS="your_email@gmail.com"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OBSERVABILITY_LOG_LEVEL=debug
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_TRACING_ENABLED=true

# Garage file storage
GARAGE_RPC_SECRET="openssl rand -hex 32"
GARAGE_ADMIN_TOKEN="openssl rand -hex 32"
GARAGE_METRICS_TOKEN="openssl rand -hex 32"

S3_ACCESS_KEY="snack-rate-app"
S3_ENDPOINT="http://localhost:3900"
S3_ENDPOINT_INTERNAL="http://garage:3900"
S3_REGION=garage
S3_SECRET_KEY="openssl rand -hex 32"
S3_BUCKET_UPLOADS=snack-rate-uploads
S3_BUCKET_PUBLIC=snack-rate-public

# Caddy for production, ignored in development
APP_DOMAIN=app.localhost