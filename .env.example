PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=db_user
POSTGRES_PASSWORD=ChangeThisPassword
POSTGRES_DB=app_db
DATABASE_URL="postgresql://db_user:ChangeThisPassword@localhost:5432/app_db"

# Grafana
GRAFANA_INITIAL_ADMIN_USER=admin
GRAFANA_INITIAL_ADMIN_PASSWORD="ChangeGrafanaPassword"
GRAFANA_SMTP="smtp.gmail.com:587"
GRAFANA_SMTP_USER="your_email@gmail.com"
GRAFANA_SMTP_PASSWORD="your_app_password"
GRAFANA_SMTP_FROM_ADDRESS="your_email@gmail.com"

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OBSERVABILITY_LOG_LEVEL=debug
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_TRACING_ENABLED=true

# Garage file storage
GARAGE_RPC_SECRET="replace-with-a-random-hex-string"
GARAGE_ADMIN_TOKEN="replace-with-a-random-base64-string"
GARAGE_METRICS_TOKEN="replace-with-a-random-base64-string"
GARAGE_DEFAULT_ACCESS_KEY=garage
GARAGE_DEFAULT_SECRET_KEY="replace-with-a-random-secret"
GARAGE_DEFAULT_BUCKET=snack-rate-files
GARAGE_URL="http://localhost:3900"

# Caddy for production, ignored in development
APP_DOMAIN=app.localhost