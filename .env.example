PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=db_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=app_db
DATABASE_URL=postgresql://db_user:change-this-postgres-password@localhost:5432/app_db

# Grafana
GRAFANA_SMTP="smtp.gmail.com:587"
GRAFANA_SMTP_USER="your_email@gmail.com"
GRAFANA_SMTP_PASSWORD="your_app_password"
GRAFANA_SMTP_FROM_ADDRESS="your_email@gmail.com"


# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OBSERVABILITY_LOG_LEVEL=debug
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_TRACING_ENABLED=true

# Caddy for production, ignored in development
APP_DOMAIN=yourdomain.com