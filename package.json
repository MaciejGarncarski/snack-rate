{
  "name": "snack-rate",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --strip-types --import ./bootstrap/bootstrap.ts .output/server/index.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "node --env-file=.env.development ./drizzle/scripts/seed.ts",
    "db:reset": "node --env-file=.env.development ./drizzle/scripts/reset.ts",
    "db:studio": "drizzle-kit studio",
    "infra:up": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development up -d",
    "infra:down": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development down",
    "infra:logs": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development logs -f",
    "infra:restart": "pnpm run infra:down && pnpm run infra:up",
    "proxy:generate-hash": "docker run --rm -it caddy:2-alpine caddy hash-password --plaintext",
    "proxy:up": "docker compose -p snack-rate-proxy -f compose.caddy.yml --env-file .env.caddy up -d",
    "proxy:down": "docker compose -p snack-rate-proxy -f compose.caddy.yml --env-file .env.caddy down",
    "proxy:logs": "docker compose -p snack-rate-proxy -f compose.caddy.yml --env-file .env.caddy logs -f",
    "proxy:restart": "pnpm run proxy:down && pnpm run proxy:up",
    "staging:up": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging up -d",
    "staging:down": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging down",
    "staging:logs": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging logs -f",
    "staging:restart": "pnpm run staging:down && pnpm run staging:up",
    "prod:up": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production up -d",
    "prod:down": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production down",
    "prod:logs": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production logs -f",
    "prod:restart": "pnpm run prod:down && pnpm run prod:up"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@orpc/client": "^1.14.3",
    "@orpc/json-schema": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/otel": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/tanstack-query": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0",
    "nitro": "npm:nitro-nightly@latest",
    "p-retry": "^8.0.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.3.1",
    "drizzle-seed": "^0.3.1",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
