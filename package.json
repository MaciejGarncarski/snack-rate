{
  "name": "snack-rate",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "pnpm --filter @snack-rate/db-schema exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @snack-rate/db-schema exec drizzle-kit migrate",
    "db:push": "pnpm --filter @snack-rate/db-schema exec drizzle-kit push",
    "db:pull": "pnpm --filter @snack-rate/db-schema exec drizzle-kit pull",
    "db:seed": "pnpm --filter @snack-rate/db-schema exec -- node --env-file=../../.env.development drizzle/scripts/seed.ts",
    "db:seed-prod": "node --env-file=.env.production packages/db-schema/drizzle/scripts/seed-prod.ts",
    "db:migrate-and-seed-prod": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production run --rm db-tool",
    "db:migrate-and-seed-staging": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging run --rm db-tool",
    "db:reset": "node --env-file=.env.development packages/db-schema/drizzle/scripts/reset.ts",
    "db:studio": "pnpm --filter @snack-rate/db-schema exec drizzle-kit studio",
    "backup:run": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production run --rm backup",
    "backup:run-staging": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging run --rm backup",
    "backup:cron": "sh scripts/install-backup-cron.sh prod",
    "backup:cron-staging": "sh scripts/install-backup-cron.sh staging",
    "infra:up": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development up -d",
    "infra:down": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development down",
    "infra:logs": "docker compose -p snack-rate-dev -f compose.yml -f compose.dev.yml --env-file .env.development logs -f",
    "infra:restart": "pnpm run infra:down && pnpm run infra:up",
    "garage:init": "sh scripts/garage-init.sh",
    "hash-password": "docker run --rm -it caddy:2-alpine caddy hash-password --plaintext",
    "staging:up": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging up -d",
    "staging:down": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging down",
    "staging:logs": "docker compose -p snack-rate-staging -f compose.yml -f compose.staging.yml --env-file .env.staging logs -f",
    "staging:restart": "pnpm run staging:down && pnpm run staging:up",
    "prod:up": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production up -d",
    "prod:down": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production down",
    "prod:logs": "docker compose -p snack-rate-prod -f compose.yml -f compose.prod.yml --env-file .env.production logs -f",
    "prod:restart": "pnpm run prod:down && pnpm run prod:up"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@orpc/client": "^1.14.3",
    "@orpc/json-schema": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/otel": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/tanstack-query": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@remix-run/form-data-parser": "^0.17.4",
    "@snack-rate/db-schema": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.7",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.168.18",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^22.0.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "nanoid": "catalog:",
    "nitro": "npm:nitro-nightly@3.0.260610-beta",
    "p-limit": "^7.3.0",
    "p-retry": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.0.2",
    "react-intersection-observer": "^10.0.3",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/eslint-plugin-query": "^5.100.10",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@tanstack/react-hotkeys-devtools": "^0.7.0",
    "@testcontainers/postgresql": "^12.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-seed": "catalog:",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pino-pretty": "^13.1.3",
    "tsx": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.13.0"
}
