{
	log {
		output stdout
		format json
	}
}

{$APP_DOMAIN} {
	rate_limit {
		key {remote_host}
		events 100
		window 1m
	}
	handle /grafana* {
		uri strip_prefix /grafana
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy app:{$APP_PORT}
	}
}

{$PUBLIC_BUCKET_DOMAIN} {
	handle {
		reverse_proxy {$PUBLIC_BUCKET_BACKEND} {
			header_up Host {$PUBLIC_BUCKET_HOST}
		}
	}

	@static {
		path *.js *.css *.png *.jpg *.jpeg *.webp *.svg *.avif *.woff2
	}

	header @static Cache-Control "public, max-age=31536000, immutable"
}
