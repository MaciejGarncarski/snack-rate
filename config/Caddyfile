{$APP_DOMAIN} {
    handle /grafana* {
        uri strip_prefix /grafana
        reverse_proxy prod-grafana:3000
    }
    
    handle {
        reverse_proxy prod-app:3000
    }
}

{$STORAGE_DOMAIN} {
    handle {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy garage:3900
    }
}

{$STAGING_APP_DOMAIN} {
    route {
        handle /robots.txt {
            respond <<ROBOTS
                User-agent: *
                Disallow: /
                ROBOTS 200
        }

        basic_auth {
            {$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
        }

        handle /grafana* {
            uri strip_prefix /grafana
            reverse_proxy staging-grafana:3000
        }

        handle {
            reverse_proxy staging-app:3000
        }
    }
}